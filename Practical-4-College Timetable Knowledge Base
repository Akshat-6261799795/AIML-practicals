% Find subjects taught by a faculty
faculty_subject(Faculty, Subject) :-
    timetable(_, Subject, Faculty, _).

% Find classroom of a subject
subject_room(Subject, Room) :-
    timetable(_, Subject, _, Room).

% Find faculty teaching a subject
subject_faculty(Subject, Faculty) :-
    timetable(_, Subject, Faculty, _).

% Find timetable for a particular day
day_timetable(Day, Subject, Faculty, Room) :-
    timetable(Day, Subject, Faculty, Room).



